{
  "version": "1.0.0-preview",
  "purpose": "Read-only integration readiness discovery; does not activate connectors",
  "security": {
    "neverAskFor": [
      "API keys",
      "passwords",
      "service_role key",
      "database credentials",
      "Windows administrator password",
      "remote desktop access code"
    ],
    "pairing": "Use one-time pairing and a separate approved provisioning channel after owner verification",
    "activation": "Only backend staff-approved capability gate may enable booking/operations"
  },
  "entryRole": "Owner or verified delegated lounge manager; staff can submit answers but cannot approve pairing",
  "questions": [
    {
      "id": "system",
      "kind": "select",
      "required": true,
      "ar": "الصالة بتستخدم برنامج إدارة حاليًا؟ موجود فين؟",
      "en": "Where does your current management software run?",
      "options": [
        {
          "value": "none",
          "ar": "معندناش برنامج",
          "en": "No system"
        },
        {
          "value": "cloud",
          "ar": "على الإنترنت (Cloud)",
          "en": "Cloud"
        },
        {
          "value": "windowsLocal",
          "ar": "على كمبيوتر Windows بالصالة",
          "en": "Windows PC in lounge"
        },
        {
          "value": "otherLocal",
          "ar": "على جهاز محلي تاني",
          "en": "Other local device"
        },
        {
          "value": "unknown",
          "ar": "مش عارف",
          "en": "Not sure"
        }
      ]
    },
    {
      "id": "vendorName",
      "kind": "text",
      "required": true,
      "ar": "اسم البرنامج إيه؟",
      "en": "What is the software name?",
