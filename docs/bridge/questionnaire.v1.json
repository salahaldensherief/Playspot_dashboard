        "system": [
          "cloud",
          "windowsLocal",
          "otherLocal",
          "unknown"
        ]
      },
      "hint_ar": "اكتب الاسم اللي ظاهر في شاشة البرنامج؛ من غير باسورد"
    },
    {
      "id": "vendorVersion",
      "kind": "text",
      "required": true,
