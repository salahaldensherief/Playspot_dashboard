        {
          "value": "none",
          "ar": "مفيش برنامج — عايز PlaySpot OS",
          "en": "No existing software — use PlaySpot OS"
        },
        {
          "value": "cloud",
          "ar": "نظام أونلاين (Cloud)",
          "en": "Online/cloud service"
        },
        {
          "value": "windowsLocal",
          "ar": "برنامج على Windows داخل الصالة",
          "en": "Windows PC at the lounge"
        },
        {
          "value": "otherLocal",
          "ar": "جهاز محلي غير Windows",
