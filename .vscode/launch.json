{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PlaySpot Dashboard (Chrome)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "chrome",
        "--dart-define-from-file=.env"
      ]
    },
    {
      "name": "PlaySpot Dashboard (Edge)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "edge",
        "--dart-define-from-file=.env"
      ]
    },
    {
      "name": "PlaySpot - Local backend (Chrome, explicit config)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "chrome",
      "toolArgs": [
        "--no-pub",
        "--dart-define-from-file=${workspaceFolder}/.env.local.json"
      ],
      "preLaunchTask": "PlaySpot: validate local backend (offline)"
    },
    {
      "name": "PlaySpot - OFFLINE equipment preview (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "tool/equipment_cards_preview.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "chrome",
      "toolArgs": [
        "--no-pub"
      ]
    },
    {
      "name": "PlaySpot - Isolated loopback backend (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "chrome",
      "toolArgs": [
        "--no-pub",
        "--web-port=51651",
        "--dart-define-from-file=${workspaceFolder}/.env.isolated.json"
      ],
      "preLaunchTask": "PlaySpot: validate isolated loopback (offline)"
    }
  ]
}
